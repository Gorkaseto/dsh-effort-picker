{
  "name": "dsh-effort-picker",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "gorkaseto",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gorkaseto/dsh-effort-picker.git"
  },
  "homepage": "https://github.com/Gorkaseto/dsh-effort-picker#readme",
  "description": "Sticky effort slider inside the composer model menu (generic levels for custom pi-ai providers)",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE", "NOTICE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  }
}
